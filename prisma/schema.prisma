generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión pooled (host con -pooler) — la usa Prisma Client
  directUrl = env("DIRECT_URL")   // conexión directa (host sin -pooler) — la usa la CLI (migrate, db push)
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  priceCents  Int // precio en centavos para evitar errores de redondeo
  imageUrl    String
  stock       Int         @default(20)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]

  @@index([categoryId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(PENDING)
  totalCents      Int
  customerEmail   String?
  paypalOrderId   String?     @unique
  paypalCaptureId String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  priceCents  Int // precio congelado al momento de la compra

  @@index([orderId])
}
